{
  "name": "@ecommerce/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute ecommerce-d1 --local --file=./drizzle/0000_initial.sql",
    "db:migrate:remote": "wrangler d1 execute ecommerce-d1 --remote --file=./drizzle/0000_initial.sql",
    "db:seed:local": "wrangler d1 execute ecommerce-d1 --local --file=./src/db/seed.sql",
    "db:seed:remote": "wrangler d1 execute ecommerce-d1 --remote --file=./src/db/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
